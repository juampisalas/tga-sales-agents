# Phase 1 example only. No secrets belong in this file.
# LinkedIn passwords are never stored.
# Copy to .env only when a later phase needs a value. .env is gitignored.

# Official HubSpot private-app token. The tool reads it from the environment.
# Leave it empty here. Never paste the token into chat.
HUBSPOT_ACCESS_TOKEN=

# SQLite path for the persistence placeholder. Tests use an in-memory database.
DATABASE_PATH=./data/tga-sales-agents.sqlite


OPENAI_API_KEY=
